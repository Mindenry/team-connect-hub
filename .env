# Backend API URL
# For Local Development:
VITE_API_URL=http://localhost:3000
# For Ngrok: Uncomment and use your ngrok URL
# VITE_API_URL=https://your-ngrok-url.ngrok-free.dev

# LiveKit URL - backend proxies /rtc to LiveKit server
# Do NOT include /rtc here - LiveKit client adds /rtc/v1 automatically
# For Local Development:
VITE_LIVEKIT_URL=ws://localhost:7880
# For Ngrok: Uncomment and use wss://
# VITE_LIVEKIT_URL=wss://your-ngrok-url.ngrok-free.dev

# TURN Server Credentials (ใส่ค่าจาก Metered.ca หรือ Twilio)
# เปิด https://www.metered.ca/tools/openrelay/ แล้ว copy credentials มาใส่
VITE_TURN_URL=turn:global.relay.metered.ca:80
